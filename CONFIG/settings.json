{
  "duration": {
    "mode": "auto",
    "default_seconds": 30,
    "min_seconds": 1,
    "max_seconds": 300,
    "allow_early_done_signal": true
  },
  "video": {
    "default_orientation": "landscape",
    "portrait": {
      "width": 1080,
      "height": 1920
    },
    "landscape": {
      "width": 1920,
      "height": 1080
    },
    "fps": 30,
    "codec": "libx264",
    "crf": 20,
    "preset": "veryfast"
  },
  "browser": {
    "navigation_timeout_ms": 30000,
    "wait_before_recording_ms": 800
  },
  "audio": {
    "enabled": true,
    "sample_rate": 48000,
    "channels": 2,
    "bitrate": "192k"
  }
}
